<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_system"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSystems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbBin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bin_label" />

            <RadioButton
                android:id="@+id/rbOct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/oct_label" />

            <RadioButton
                android:id="@+id/rbDec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/dec_label" />

            <RadioButton
                android:id="@+id/rbHex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hex_label" />

            <RadioButton
                android:id="@+id/rbRoman"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/roman_label" />

            <RadioButton
                android:id="@+id/rbGematria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gematria_label" />

        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilInput"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/enter_number"
            app:errorEnabled="true"
            app:helperText="@string/range_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInputNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConvert"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/btn_all_types"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
